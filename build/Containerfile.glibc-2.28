FROM quay.io/rockylinux/rockylinux@sha256:f5529992e67440c1a4ae7788244d4381c6909159a88eacd95b7523ae47ced82e

RUN dnf install -y --setopt=install_weak_deps=False binutils ca-certificates curl diffutils findutils gcc gcc-c++ git gnupg2 jq libcap-devel make ncurses-devel pcre2-devel pkgconf-pkg-config tar xz zsh && dnf clean all && rm -rf /var/cache/dnf

LABEL org.wakamex.wsh.glibc-floor="2.28"
