FROM quay.io/rockylinux/rockylinux@sha256:f5529992e67440c1a4ae7788244d4381c6909159a88eacd95b7523ae47ced82e

COPY build/rocky-8.10-packages.lock /tmp/expected-packages.lock

RUN dnf install -y --setopt=install_weak_deps=False autoconf binutils ca-certificates curl diffutils findutils gcc gcc-c++ git gnupg2 jq libcap-devel make ncurses-devel patch pcre2-devel pkgconf-pkg-config tar xz zsh \
    && rpm -qa --qf '%{NAME}\t%{EPOCHNUM}\t%{VERSION}\t%{RELEASE}\t%{ARCH}\t%{SHA256HEADER}\t%{PAYLOADDIGESTALGO}\t%{PAYLOADDIGEST}\n' | LC_ALL=C sort > /tmp/actual-packages.lock \
    && diff -u /tmp/expected-packages.lock /tmp/actual-packages.lock \
    && dnf clean all \
    && rm -rf /var/cache/dnf /tmp/actual-packages.lock /tmp/expected-packages.lock

LABEL org.wakamex.wsh.glibc-floor="2.28"
