@@ -1476,6 +1476,62 @@
  * then we source the standard sh/ksh scripts instead of *
  * the standard zsh scripts                              */
 
+/* Wsh prototype: installation lookup is independent of user activation state. */
+static char *wsh_root;
+
+static void
+wsh_source(char *name)
+{
+    char *file;
+    if (!wsh_root)
+        return;
+    file = tricat(wsh_root, "/share/wsh/", name);
+    source(file);
+    zsfree(file);
+}
+
+static void
+wsh_profile(char *event)
+{
+    char *command;
+    if (!wsh_root || !shfunctab->getnode(shfunctab, "_wsh_profile_event"))
+        return;
+    command = dyncat("_wsh_profile_event ", event);
+    execstring(command, 1, 0, "wsh-profile");
+    zsfree(command);
+}
+
+static void
+wsh_setup(void)
+{
+    char *exepath = getsparam("ZSH_EXEPATH"), *slash, *file;
+    if (!exepath || unset(RCS) || isset(PRIVILEGED))
+        return;
+    wsh_root = ztrdup(exepath);
+    slash = strrchr(wsh_root, '/');
+    if (!slash)
+        goto unavailable;
+    *slash = '\0';
+    slash = strrchr(wsh_root, '/');
+    if (!slash)
+        goto unavailable;
+    *slash = '\0';
+    file = tricat(wsh_root, "/share/wsh/", "native-before.zsh");
+    if (access(unmeta(file), R_OK)) {
+        zsfree(file);
+        goto unavailable;
+    }
+    zsfree(file);
+    setsparam("WSH_BUNDLE_ROOT", ztrdup(wsh_root));
+    wsh_source("native-before.zsh");
+    return;
+
+unavailable:
+    zsfree(wsh_root);
+    wsh_root = NULL;
+    zwarn("Wsh integration unavailable; starting Zsh without Wsh defaults");
+}
+
 /**/
 void
 run_init_scripts(void)
